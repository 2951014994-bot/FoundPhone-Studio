        "richText": "{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"刮痧教程：基础手法与注意事项\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"健康科普 · 入门阅读\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"刮痧是什么？\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"刮痧是传统外治方法之一，通常使用边缘圆滑的工具配合介质，在皮肤表面进行轻柔、单向的刮拭。不同部位和人群的适用情况并不相同。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"基础准备\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"选择边缘光滑、无裂口的正规工具。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"清洁皮肤和工具，使用适合皮肤的润滑介质。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"力度以舒适为准，不追求越红越有效。\"}]}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"基础操作原则\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"先在小范围轻柔尝试，动作保持平稳，不在同一位置反复用力。出现明显疼痛、麻木、破皮或不适时立即停止。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"这些情况不要自行刮痧\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"皮肤有伤口、感染、皮疹或明显炎症。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"有出血倾向、正在使用抗凝药物，或存在相关基础疾病。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"孕期、儿童、体弱者或不确定是否适合的人群，应先咨询专业医务人员。\"}]}]}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"刮痧不能替代诊断和治疗。若症状持续或加重，应及时就医。\"}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"相关搜索\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"刮痧板怎么选择 · 刮痧后注意事项 · 哪些人不适合刮痧\"}]}]}"
      },
