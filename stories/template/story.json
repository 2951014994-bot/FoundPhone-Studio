        "richText": "{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"新手插花教程：从一束花开始\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"入门指南 · 约 8 分钟阅读\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"准备材料\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"花材 5–9 枝：选择一种主花、少量配花和叶材。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"花器：口径略小于花束展开宽度的花瓶。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"工具：干净剪刀、清水、花材保鲜剂（可选）。\"}]}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"第一步：处理花材\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"去掉水线以下的叶片，斜剪花茎底部。不同花材长度可以错开，先不要剪得太短，方便后续调整。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"第二步：确定主次\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"先放主花，再围绕主花加入配花。让花头高低错落，避免所有花朵排成同一条直线。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"第三步：调整轮廓\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"从正面和侧面观察花束，适当留出空隙。叶材用来连接花朵，不需要把每个空位都填满。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"养护小贴士\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"每天换水并清洗花瓶。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"每隔一两天重新修剪花茎。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"避免阳光直晒、空调出风口和成熟水果旁边。\"}]}]}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"新手先练习控制高低和疏密，比追求复杂造型更重要。\"}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"相关搜索\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"螺旋花束怎么扎 · 家庭插花配色 · 鲜花怎么延长花期\"}]}]}"
