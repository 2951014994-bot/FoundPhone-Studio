        "richText": "{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"北京哪座山人少？周末安静徒步参考\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"周末出行灵感 · 非实时人流信息\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"想避开人群，可以这样选\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"相比热门景区和网红登山入口，一些距离市区稍远、公共交通不那么方便的郊野步道，工作日或非节假日通常更安静。但实际人流会受天气、季节和活动影响。\"}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"可以先了解的方向\"}]},{\"type\":\"bulletList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"门头沟部分郊野步道：山地线路较多，出发前确认开放情况和交通。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"房山浅山区：可寻找正规开放的森林步道，注意部分区域可能临时封闭。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"延庆、怀柔外围：路程较远，适合提前规划的一日徒步。\"}]}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"出发前检查\"}]},{\"type\":\"orderedList\",\"content\":[{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"确认景区或步道官方开放公告。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"查看天气、日落时间和公共交通末班车。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"选择有明确路线标识的开放线路，不翻越围栏、不进入未开放区域。\"}]}]},{\"type\":\"listItem\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"带足饮水、充电设备和适合的衣物，尽量结伴出行。\"}]}]}]},{\"type\":\"heading\",\"content\":[{\"type\":\"text\",\"text\":\"避开人流的小技巧\"}]},{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"尽量选择普通周末的早晨出发，避开节假日和热门活动日。不要为了人少而独自进入无信号、无标识的野山。\"}]},{\"type\":\"blockquote\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"本页是原创路线选择建议，不代表实时客流或景区开放状态。\"}]}]},{\"type\":\"heading\",